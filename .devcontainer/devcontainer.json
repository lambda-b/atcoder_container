{
  "name": "AtCoder Rust",
  "build": {
    "dockerfile": "Dockerfile",
    "args": {
      "VARIANT": "jammy"
    }
  },
  "features": {
    "ghcr.io/devcontainers/features/git:1": {},
    "ghcr.io/devcontainers/features/rust:1": {
      "version": "1.89.0",
      "components": "clippy,rustfmt"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": [
        "rust-lang.rust-analyzer",
        "vadimcn.vscode-lldb",
        "eamodio.gitlens",
        "mosapride.zenkaku",
        "oderwat.indent-rainbow",
        "shardulm94.trailing-spaces",
        "streetsidesoftware.code-spell-checker",
        "openai.chatgpt"
      ]
    }
  },
  "initializeCommand": ".devcontainer/scripts/initialize.sh",
  "mounts": [
    "source=${localWorkspaceFolder}/.codex-local,target=/home/vscode/.codex,type=bind",
    "source=${localEnv:HOME}/.codex/auth.json,target=/home/vscode/.codex/auth.json,type=bind"
  ],
  "postCreateCommand": "cargo install --locked cargo-equip",
  "remoteUser": "vscode"
}
