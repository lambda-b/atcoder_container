{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "shell",
      "label": "AtCoder: Build and test active problem",
      "command": "${workspaceFolder}/scripts/rusttest.sh",
      "args": [
        "${workspaceFolder}",
        "${file}"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": [
        "$rustc"
      ],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    }
  ]
}
